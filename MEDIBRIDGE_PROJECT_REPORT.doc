<h3>4.2 Module Implementation</h3>
<h4>4.2.1 WebRTC Multi-Peer Mesh Hook (<code>useWebRTC.js</code>)</h4>
<p>The <code>useWebRTC</code> custom hook orchestrates browser media acquisition and peer connections. To prevent camera initialization stalls on laptops with virtual or disabled cameras, it incorporates an automatic media fallback pipeline:</p>
<pre><code>// Excerpt from frontend/src/hooks/useWebRTC.js
const startMedia = async () =&gt; {
  try {
    const stream = await navigator.mediaDevices.getUserMedia({
      video: { width: { ideal: 1280 }, height: { ideal: 720 } },
      audio: true
    });
    setLocalStream(stream);
    setHasRealMic(true);
    return stream;
  } catch (err) {
    console.warn("Direct media capture failed, initializing fallback stream:", err.message);
    const fallbackStream = createFallbackCanvasAudioStream();
    setLocalStream(fallbackStream);
    setIsVirtualStream(true);
    return fallbackStream;
  }
};</code></pre>
<div class="page-break"></div>
<h4>4.2.2 Multi-Tier Clinical Translation &amp; Cultural Honorific Polisher (<code>translationService.js</code>)</h4>
<p>The translation engine executes a 4-tier fallback strategy coupled with an automated Unicode Tamil honorific refinement engine:</p>
<pre><code>// Excerpt from backend/services/translationService.js
const POLISH_PAIRS = [
  ['உனக்கு', 'உங்களுக்கு'],
  ['உன்னால்', 'உங்களால்'],
  ['உன்னை', 'உங்களை'],
  ['உன்', 'உங்கள்'],
  ['நீ', 'நீங்கள்'],
  ['கவலைப்படாதே', 'கவலைப்பட வேண்டாம்'],
  ['சாப்பிடு', 'சாப்பிடுங்கள்'],
  ['குடி', 'குடியுங்கள்'],
  ['காட்டு', 'காட்டுங்கள்'],
  ['தளர்வான இயக்கம்', 'வயிற்றுப்போக்கு'] // Fix literal machine translation of "loose motion"
];

const polishTamilHonorifics = (tamilText) =&gt; {
  if (!tamilText || typeof tamilText !== 'string') return tamilText;
  let text = tamilText;
  for (const [target, replacement] of POLISH_PAIRS) {
    if (target.includes(' ')) {
      text = text.replaceAll(target, replacement);
    } else {
      // Unicode-aware word boundary regex for Tamil script (\u0B80-\u0BFF)
      const regex = new RegExp(`(^|[^\\u0B80-\\u0BFF])${target}(?=[^\\u0B80-\\u0BFF]|$)`, 'gu');
      text = text.replace(regex, `$1${replacement}`);
    }
  }
  return text;
};</code></pre>
<div class="page-break"></div>
<h4>4.2.3 Real-Time Signalling Hub (<code>socketService.js</code>)</h4>
<p>Socket.IO coordinates WebRTC peer connections, live speech subtitles, and interpreter requests:</p>
<pre><code>// Excerpt from backend/services/socketService.js
socket.on('join_room', ({ roomId, user }) =&gt; {
  socket.join(roomId);
  socket.roomId = roomId;
  socket.userData = user;
  
  // Collect existing room participants and notify new arrival
  const existingPeers = [];
  roomUsers.get(roomId).forEach((peerId) =&gt; {
    if (peerId !== socket.id) {
      const pSocket = io.sockets.sockets.get(peerId);
      if (pSocket?.userData) existingPeers.push({ socketId: peerId, user: pSocket.userData });
    }
  });
  socket.emit('existing_peers', { peers: existingPeers });
  socket.to(roomId).emit('user_joined', { socketId: socket.id, user });
});</code></pre>
